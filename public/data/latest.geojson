 vântului\nZone afectate: județele Vrancea, Galați, Buzău, Brăila, Ialomița, Tulcea și Constanța\n\r\n      Pe parcursul zilei de luni (28 septembrie) \nîn județele Vrancea, Galați, Buzău, Brăila, Ialomița, Tulcea și Constanta vântul va avea intensificări cu viteze de 50...70 km/h.\n\r\nÎn funcţie de evoluţia şi intensitatea fenomenelor meteorologice, Administraţia Naţională de Meteorologie va actualiza prezentul mesaj\n.","feature_meta":{"VN":{"county_code":"VN","county_name":"Vrancea","zone_name":"Vrancea","display_name":"Vrancea","localities":[],"geometry_source":"coordGis","match_confidence":"high"},"GL":{"county_code":"GL","county_name":"Galați","zone_name":"Galați","display_name":"Galați","localities":[],"geometry_source":"coordGis","match_confidence":"high"},"BZ":{"county_code":"BZ","county_name":"Buzău","zone_name":"Buzău","display_name":"Buzău","localities":[],"geometry_source":"coordGis","match_confidence":"high"},"BR":{"county_code":"BR","county_name":"Brăila","zone_name":"Brăila","display_name":"Brăila","localities":[],"geometry_source":"coordGis","match_confidence":"high"},"IL":{"county_code":"IL","county_name":"Ialomița","zone_name":"Ialomița","display_name":"Ialomița","localities":[],"geometry_source":"coordGis","match_confidence":"high"},"TL":{"county_code":"TL","county_name":"Tulcea","zone_name":"Tulcea","display_name":"Tulcea","localities":[],"geometry_source":"coordGis","match_confidence":"high"},"CT":{"county_code":"CT","county_name":"Constanța","zone_name":"Constanța","display_name":"Constanța","localities":[],"geometry_source":"coordGis","match_confidence":"high"}},"source_url":"","source_label":"","notes":""}],"alert_count":1,"general_alert_count":1,"nowcasting_alert_count":0,"manual_nowcasting_alert_count":0,"feature_count":7,"general_feature_count":7,"nowcasting_feature_count":0,"max_color":1,"general_max_color":1,"nowcasting_count":0,"has_nowcasting":false,"has_manual_nowcasting":false,"calendar_badge":"","sources":["general"],"alerts_by_co